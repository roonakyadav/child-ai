# ==============================================================================
# Child AI Backend - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide deployment-specific values.
# NEVER commit real credentials, API keys, or secrets to version control.

# Node environment (production | development | test)
NODE_ENV=production

# Server port
PORT=3001

# Allowed CORS origins (comma-separated list of exact HTTPS origins, NO wildcards in production)
# Example: https://app.example.com,https://child-ai.example.com
ALLOWED_ORIGINS=https://app.example.com

# Groq AI Provider Credentials (REQUIRED)
GROQ_API_KEY=your_groq_api_key_here

# Groq request timeout in milliseconds (default: 30000)
GROQ_TIMEOUT_MS=30000

# Persistent Server-Authoritative Configuration File Path (REQUIRED in production)
# Must be on a persistent, writable volume in containerized deployments
CONFIG_STORE_PATH=/app/data/parentConfig.json

# Reverse Proxy / Load Balancer Trust Configuration
# 1 = Trust first upstream hop (e.g., Cloudflare, AWS ALB, Nginx, Vercel)
# Can also be set to a subnet like '10.0.0.0/8' or 'loopback'
TRUST_PROXY=1

# Cookie Security Settings
# COOKIE_SAME_SITE: lax (default, recommended) | strict | none (requires HTTPS)
COOKIE_SAME_SITE=lax

# Session Expiration in milliseconds (default: 1800000 = 30 minutes)
SESSION_EXPIRY_MS=1800000

# Rate Limiting Configuration
# RATE_LIMIT_WINDOW_MS: Window size in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX: Max general API requests per window per IP (default: 100)
RATE_LIMIT_MAX=100
# AI_RATE_LIMIT_MAX: Max AI chat requests per window per IP (default: 30)
AI_RATE_LIMIT_MAX=30
# AUTH_RATE_LIMIT_MAX: Max authentication attempts per window per IP (default: 10)
AUTH_RATE_LIMIT_MAX=10
