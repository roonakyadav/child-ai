# API Configuration
# The base URL for the backend API server
# In development, this typically points to your local backend server
# In production, this should point to your deployed backend API
VITE_API_URL=http://localhost:3001

# CORS Configuration
# Comma-separated list of allowed frontend origins for CORS
# In development, defaults to http://localhost:5173 if not set
# In production, this MUST be set or the server will fail to start
# Example: ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173
