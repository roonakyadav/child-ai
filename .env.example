# API Configuration
# The base URL for the backend API server
# In development, this typically points to your local backend server
# In production, this should point to your deployed backend API
VITE_API_URL=http://localhost:3001

# Frontend API request timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT_MS=30000

# CORS Configuration
# Comma-separated list of allowed frontend origins for CORS
# In development, defaults to http://localhost:5173 if not set
# In production, this MUST be set or the server will fail to start
# Example: ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173

# Groq API Configuration
# API key for Groq AI service
GROQ_API_KEY=your_groq_api_key_here

# Groq API request timeout in milliseconds (default: 30000)
GROQ_TIMEOUT_MS=30000

# Server-Side Session Configuration
# Session lifetime in milliseconds (default: 1800000 = 30 minutes)
SESSION_EXPIRY_MS=1800000

# Maximum active in-memory sessions before bounded eviction (default: 1000)
MAX_ACTIVE_SESSIONS=1000

# Authentication rate limiting: max attempts per 15-minute window (default: 10)
AUTH_RATE_LIMIT_MAX=10
